model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	maxParallelismPerRefresh: 1
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parametros

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["mvp solicitacao_servicos","mvp base_clientes","d_Calendario","Medidas","Atualizacao","host","database"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop","TMDLView_Desktop","MCP-PBIModeling"]

annotation __TEdtr = 1

ref table 'mvp solicitacao_servicos'
ref table Medidas
ref table d_Calendario
ref table Atualizacao
ref table par_med_Backlog_Reparos
ref table 'mvp base_clientes'
ref table Parâmetro_analitico

ref cultureInfo pt-BR

