	column ajuste_uf = ```
			
			VAR estadosSSE = {"MG", "PR", "SP"}
			VAR estadosNONE = {"CE", "MA", "PA", "PI"}
			VAR estadosNE = {"BA", "CE", "PB", "PE", "RN"}
			RETURN
			    SWITCH(
			        TRUE(),
			        'reincidencia_reparo'[uf] = "SP" && 'reincidencia_reparo'[filial_regional] IN {"FILIAL MG", "ICONECTA", "VOUE"}, "MG",
			
			        --(ISBLANK('reincidencia_reparo'[uf]) || 'reincidencia_reparo'[uf] = ""), "SEM INFORMAÇÃO",
			
			        'reincidencia_reparo'[empresa] = "ZAAZ NORDESTE" && NOT('reincidencia_reparo'[uf] IN estadosNE), "PB",
			        'reincidencia_reparo'[empresa] = "ZAAZ NORTE" && NOT('reincidencia_reparo'[uf] IN estadosNONE), "PA",
			        'reincidencia_reparo'[empresa] = "ZAAZ SUL/SUDESTE" && NOT('reincidencia_reparo'[uf] IN estadosSSE), "SP",
			        
			        'reincidencia_reparo'[uf]
			    )
			
			```
		lineageTag: 0eceefae-f4de-4d53-b47b-8f1666a1243a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column data_abertura_intervalo =
			
			
			VAR _hoje = TODAY()
			VAR _dataabertura = 'reincidencia_reparo'[data_abertura]
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_dataabertura), BLANK(),
			    _dataabertura = _hoje, "HOJE",
			    YEAR(_dataabertura) = YEAR(_hoje) && MONTH(_dataabertura) = MONTH(_hoje), "MÊS ATUAL",
			    _dataabertura < DATE(YEAR(_hoje), MONTH(_hoje), 1), "MESES ANTERIORES",
			    _dataabertura > EOMONTH(_hoje, 0), "MÊS FUTURO",
			    "OUTRO"
			)
		lineageTag: 288cbf35-c2f3-4089-978c-12f10b03fcfb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

