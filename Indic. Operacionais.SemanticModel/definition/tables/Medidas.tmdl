	measure PROJEÇÃO_REPARO =
			
			
			IF(
			    [TOTAL_REPARO] > 0,
			    COALESCE(
			        ROUND(
			            DIVIDE(
			                [TOTAL_REPARO],
			                [DU REAL]
			            ) * [DU PLAN],
			            0
			        ),
			        0
			    ),
			    BLANK()
			)
		formatString: #,0
		displayFolder: EntranteBase\Totais
		lineageTag: d2125615-7fe9-456a-96f9-c6557f2a7df4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Clientes_count =
			
			
			VAR estagiosAtivos = {"ATIVO"}
			VAR statusAtivos = {
			    "AGUARDANDO ASSINATURA",
			    "ATIVO",
			    "BLOQUEIO ADMINISTRATIVO",
			    "BLOQUEIO AUTOMATICO",
			    "BLOQUEIO FINANCEIRO",
			    "BLOQUEIO MANUAL",
			    "CORTESIA",
			    "FINANCEIRO EM ATRASO"
			}
			
			
			VAR EmpresasContexto =
			    VALUES('mvp solicitacao_servicos'[empresa])
			VAR UFsContexto =
			    VALUES('mvp solicitacao_servicos'[uf_ajustada])
			VAR CidadesContexto =
			    SELECTCOLUMNS(
			        VALUES('mvp solicitacao_servicos'[cidade]),
			        "Cidade",
			            VAR CidadeAtual = 'mvp solicitacao_servicos'[cidade]
			            VAR PosicaoUF = SEARCH(" | ", CidadeAtual, 1, 0)
			            RETURN
			                IF(
			                    PosicaoUF > 0,
			                    LEFT(CidadeAtual, PosicaoUF - 1),
			                    CidadeAtual
			                )
			    )
			RETURN
			    CALCULATE(
			        --DISTINCTCOUNT('mvp base_clientes'[id_cliente]),
			        COUNTROWS('mvp base_clientes'),
			        REMOVEFILTERS('mvp solicitacao_servicos'[data_fechamento]),
			        FILTER(
			            'mvp base_clientes',
			            (
			                NOT ISINSCOPE('mvp solicitacao_servicos'[empresa])
			                    || 'mvp base_clientes'[empresa] IN EmpresasContexto
			            )
			                && (
			                    NOT ISINSCOPE('mvp solicitacao_servicos'[uf_ajustada])
			                        || 'mvp base_clientes'[ajuste_uf] IN UFsContexto
			                )
			                && (
			                    NOT ISINSCOPE('mvp solicitacao_servicos'[cidade])
			                        || 'mvp base_clientes'[ajuste_cidade] IN CidadesContexto
			                )
			        ),
			        'mvp base_clientes'[estagio] IN estagiosAtivos && 'mvp base_clientes'[status] IN statusAtivos
			    )
		formatString: #,0
		displayFolder: EntranteBase\Totais
		lineageTag: 41e19ce1-18e0-4407-9fe1-851327545931

	measure Clientes_count2 =
			
			
			VAR estagiosAtivos = {"ATIVO"}
			VAR statusAtivos = {
			    "AGUARDANDO ASSINATURA",
			    "ATIVO",
			    "BLOQUEIO ADMINISTRATIVO",
			    "BLOQUEIO AUTOMATICO",
			    "BLOQUEIO FINANCEIRO",
			    "BLOQUEIO MANUAL",
			    "CORTESIA",
			    "FINANCEIRO EM ATRASO"
			}
			
			
			RETURN
			    CALCULATE(
			        COUNTROWS('mvp base_clientes'),
			        'mvp base_clientes'[estagio] IN estagiosAtivos && 'mvp base_clientes'[status] IN statusAtivos
			    )
		formatString: 0
		displayFolder: EntranteBase\Totais
		lineageTag: cd0d8dd4-54de-4a5c-b508-a3ebd9f6d51f

	measure '{PER} Projecao_entrante_taxa' =
			
			
			DIVIDE(
			    [PROJEÇÃO_REPARO],
			    [Clientes_count],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: EntranteBase\Calculos
		lineageTag: a07c3dc7-6d4a-488a-9b16-18c4d988aaa0

	measure '{PER} Projecao_entrante_meta' =
			
			
			VAR taxa = 0.035
			RETURN
			
			IF([PROJEÇÃO_REPARO] > 0, taxa, BLANK())
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: EntranteBase\Calculos
		lineageTag: 098a149a-e6a4-48a1-85aa-e4f82744bd47

