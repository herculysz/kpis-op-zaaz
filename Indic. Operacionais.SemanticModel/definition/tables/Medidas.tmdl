	measure CUMPRIDA_NO_PRAZO_ATIV = ```
			
			IF([TOTAL_ATIV] > 0,
			CALCULATE(
			    COUNTROWS('mvp solicitacao_servicos'),
			    'mvp solicitacao_servicos'[noprazo] = 1,
			    'mvp solicitacao_servicos'[tipo_servico] = "GROSS - ATIV",
			    'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"},
			    USERELATIONSHIP(
			        d_Calendario[data],
			        'mvp solicitacao_servicos'[data_fechamento]
			    )
			)+0,
			BLANK()
			)
			
			```
		formatString: #,0
		displayFolder: GrossAtivacao\Totais
		lineageTag: 8f873144-0eca-45a0-85f9-8a1fe1a7e792

	measure peso_dia_util =
			
			
			VAR _Feriado = SELECTEDVALUE(d_Calendario[feriado], FALSE())
			VAR _DiaUtil = SELECTEDVALUE(d_Calendario[dia_util], FALSE())
			VAR _DiaSemana = SELECTEDVALUE(d_Calendario[nome_dia_semana_abrev])
			RETURN
			    IF(
			        _DiaUtil
			            && NOT _Feriado
			            && NOT (_DiaSemana IN {"sáb", "sab", "dom"}),
			        1.00,
			        0.00
			    )
		formatString: 0.00
		displayFolder: Garantia\Pesos
		lineageTag: 07ce382d-1ce6-4b88-ab0e-178299b3f3bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure peso_sabado =
			
			
			VAR _Feriado = SELECTEDVALUE(d_Calendario[feriado], FALSE())
			VAR _DiaSemana = SELECTEDVALUE(d_Calendario[nome_dia_semana_abrev])
			RETURN
			    IF(
			        NOT _Feriado
			            && _DiaSemana IN {"sáb", "sab"},
			        0.50,
			        0.00
			    )
		formatString: 0.00
		displayFolder: Garantia\Pesos
		lineageTag: 59a88e9b-d9ce-4f02-90cf-44192a1b37ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure peso_domingo =
			
			
			VAR _Feriado = SELECTEDVALUE(d_Calendario[feriado], FALSE())
			VAR _DiaSemana = SELECTEDVALUE(d_Calendario[nome_dia_semana_abrev])
			RETURN
			    IF(
			        NOT _Feriado
			            && _DiaSemana = "dom",
