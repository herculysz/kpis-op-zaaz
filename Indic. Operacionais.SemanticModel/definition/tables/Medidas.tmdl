	measure 'Reincidente_Reparo_Produtivos TESTE' =
			
			VAR _ReparosBase =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                'mvp solicitacao_servicos',
			                'mvp solicitacao_servicos'[protocolo],
			                'mvp solicitacao_servicos'[id_contrato],
			                'mvp solicitacao_servicos'[data_fechamento]
			            ),
			            "@Produtivo", CALCULATE(SUM('mvp solicitacao_servicos'[produtivo]))
			        ),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			        'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"},
			        USERELATIONSHIP(
			            d_Calendario[data],
			            'mvp solicitacao_servicos'[data_fechamento]
			        )
			    )
			
			VAR _TodosReparos =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'mvp solicitacao_servicos',
			            'mvp solicitacao_servicos'[protocolo],
			            'mvp solicitacao_servicos'[id_contrato],
			            'mvp solicitacao_servicos'[data_abertura]
			        ),
			        REMOVEFILTERS(d_Calendario),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO"
			    )
			
			VAR _Reincidentes =
			    FILTER(
			        _ReparosBase,
			        VAR _ProtocoloOriginal = [protocolo]
			        VAR _ContratoOriginal = [id_contrato]
			        VAR _DataFechamento = [data_fechamento]
			        RETURN
			            NOT ISBLANK(_ProtocoloOriginal)
			                && NOT ISBLANK(_ContratoOriginal)
			                && NOT ISBLANK(_DataFechamento)
			                && COUNTROWS(
			                    FILTER(
			                        _TodosReparos,
			                        NOT ISBLANK([protocolo])
			                            && [id_contrato] = _ContratoOriginal
			                            && [protocolo] <> _ProtocoloOriginal
			                            && [data_abertura] >= _DataFechamento
			                            && [data_abertura] <= _DataFechamento + 30
			                    )
			                ) > 0
			    )
			
			RETURN
			    SUMX(_Reincidentes, [@Produtivo]) + 0
		formatString: #,0
		displayFolder: Reincidente_Reparo\Teste
		lineageTag: 09927ad7-60cb-491f-9a09-a677cc930a5f

	measure 'Reincidente_REPARO_Contratos TESTE' =
			
			
			VAR _ReparosOrigem =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'mvp solicitacao_servicos',
			            'mvp solicitacao_servicos'[id_contrato],
			            'mvp solicitacao_servicos'[protocolo],
			            'mvp solicitacao_servicos'[data_fechamento]
			        ),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			        'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"},
			        USERELATIONSHIP(
			            d_Calendario[data],
			            'mvp solicitacao_servicos'[data_fechamento]
			        )
			    )
			
			VAR _TodosReparos =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'mvp solicitacao_servicos',
			            'mvp solicitacao_servicos'[id_contrato],
			            'mvp solicitacao_servicos'[protocolo],
			            'mvp solicitacao_servicos'[data_abertura]
			        ),
			        REMOVEFILTERS(d_Calendario),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO"
			    )
			
			VAR _ContratosReincidentes =
			    FILTER(
			        DISTINCT(
			            SELECTCOLUMNS(
			                FILTER(
			                    _ReparosOrigem,
			                    VAR _ContratoOrigem = [id_contrato]
			                    VAR _ProtocoloOrigem = [protocolo]
			                    VAR _DataFechamentoOrigem = [data_fechamento]
			                    RETURN
			                        NOT ISBLANK(_ContratoOrigem)
			                            && NOT ISBLANK(_ProtocoloOrigem)
			                            && NOT ISBLANK(_DataFechamentoOrigem)
			                            && COUNTROWS(
			                                FILTER(
			                                    _TodosReparos,
			                                    [id_contrato] = _ContratoOrigem
			                                        && [protocolo] <> _ProtocoloOrigem
			                                        && [data_abertura] >= _DataFechamentoOrigem
			                                )
			                            ) > 0
			                ),
			                "id_contrato", [id_contrato]
			            )
			        ),
			        NOT ISBLANK([id_contrato])
			    )
			
			RETURN
			    COUNTROWS(_ContratosReincidentes)
		formatString: #,0
		displayFolder: Reincidente_Reparo\Teste
		lineageTag: 508044b4-8334-4743-8525-f4a60b742166

	measure REINCIDENTE_REPARO = ```
			
			
			VAR _ReparosNoContexto =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            'mvp solicitacao_servicos',
			            "@Contrato", 'mvp solicitacao_servicos'[id_contrato],
			            "@Abertura", 'mvp solicitacao_servicos'[data_abertura],
			            "@Fechamento", 'mvp solicitacao_servicos'[data_fechamento]
			        ),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			        'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"}
			    )
			VAR _TodosOsReparos =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            'mvp solicitacao_servicos',
			            "@Contrato", 'mvp solicitacao_servicos'[id_contrato],
			            "@Abertura", 'mvp solicitacao_servicos'[data_abertura],
			            "@Fechamento", 'mvp solicitacao_servicos'[data_fechamento]
			        ),
			        REMOVEFILTERS('mvp solicitacao_servicos'),
			        REMOVEFILTERS(d_Calendario),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			        'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"}
			    )
			VAR _ComFechamentoAnterior =
			    ADDCOLUMNS(
			        _ReparosNoContexto,
			        "@FechamentoAnterior",
			            VAR _ContratoAtual = [@Contrato]
			            VAR _AberturaAtual = [@Abertura]
			            RETURN
			                MAXX(
			                    TOPN(
			                        1,
			                        FILTER(
			                            _TodosOsReparos,
			                            [@Contrato] = _ContratoAtual
			                                && [@Abertura] < _AberturaAtual
			                        ),
			                        [@Abertura], DESC
			                    ),
			                    [@Fechamento]
			                )
			    )
			RETURN
			
			IF( [TOTAL_REPARO]>0,
			COUNTROWS(
			        FILTER(
			            _ComFechamentoAnterior,
			            NOT ISBLANK([@FechamentoAnterior])
			                && NOT ISBLANK([@Abertura])
			                && DATEDIFF(
			                    DATEVALUE([@FechamentoAnterior]),
			                    DATEVALUE([@Abertura]),
			                    DAY
			                ) <= 30
			        )
			    ) + 0,
			    BLANK()
			)
			
			
			
			```
		formatString: #,0
		displayFolder: Reincidente_Reparo\Totais
		lineageTag: 65a5da33-f7b2-473c-a0e4-599affe0aed9

