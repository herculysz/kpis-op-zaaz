	measure TMR_Reparo24H =
			
			
			VAR _TMRHoras =
			    CALCULATE(
			        AVERAGE('mvp solicitacao_servicos'[duracao_servico]),
			        'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			        'mvp solicitacao_servicos'[status] IN {
			            "ENCERRAMENTO",
			            "FINALIZADA",
			            "FECHAMENTO"
			        },
			        USERELATIONSHIP(
			            d_Calendario[data],
			            'mvp solicitacao_servicos'[data_fechamento]
			        )
			    )
			VAR _TotalMinutos = ROUND(_TMRHoras * 60, 0)
			VAR _Horas = QUOTIENT(_TotalMinutos, 60)
			VAR _Minutos = MOD(_TotalMinutos, 60)
			RETURN
			    IF(
			        ISBLANK(_TMRHoras),
			        BLANK(),
			        FORMAT(_Horas, "00") & ":" & FORMAT(_Minutos, "00")
			    )
		formatString: hh:mm
		displayFolder: Reparo_SLA24H\Totais
		lineageTag: 7ec3660a-6f01-4f9a-8e69-e7747c3199f8

	measure Reincidente_REPARO_TESTE = ```
			
			
			        VAR _ChamadosBase =
			            CALCULATETABLE(
			                ADDCOLUMNS(
			                    SUMMARIZE(
			                        'mvp solicitacao_servicos',
			                        'mvp solicitacao_servicos'[protocolo],
			                        'mvp solicitacao_servicos'[id_contrato]
			                    ),
			                    "@DataFechamento", CALCULATE(MAX('mvp solicitacao_servicos'[data_fechamento])),
			                    "@DataFimGarantia", CALCULATE(MAX('mvp solicitacao_servicos'[data_termino_garantia]))
			                ),
			                'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			                'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"},
			                USERELATIONSHIP(
			                    d_Calendario[data],
			                    'mvp solicitacao_servicos'[data_fechamento]
			                )
			            )
			        VAR _TodosChamados =
			            CALCULATETABLE(
			                ADDCOLUMNS(
			                    SUMMARIZE(
			                        'mvp solicitacao_servicos',
			                        'mvp solicitacao_servicos'[protocolo],
			                        'mvp solicitacao_servicos'[id_contrato]
			                    ),
			                    "@DataAbertura", CALCULATE(MIN('mvp solicitacao_servicos'[data_abertura]))
			                ),
			                REMOVEFILTERS(d_Calendario),
			                'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			                'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"}
			            )
			        VAR _Reincidentes =
			            FILTER(
			                _ChamadosBase,
			                VAR _ProtocoloOriginal = [protocolo]
			                VAR _ContratoOriginal = [id_contrato]
			                VAR _DataFechamentoOriginal = [@DataFechamento]
			                VAR _DataFimGarantia = [@DataFimGarantia]
			                RETURN
			                    COUNTROWS(
			                        FILTER(
			                            _TodosChamados,
			                            [id_contrato] = _ContratoOriginal
			                                && [protocolo] <> _ProtocoloOriginal
			                                && [@DataAbertura] >= _DataFechamentoOriginal
			                                && [@DataAbertura] <= _DataFimGarantia
			                        )
			                    ) > 0
			            )
			        RETURN COUNTROWS(_Reincidentes)
			```
		formatString: #,0
		displayFolder: Reincidente_Reparo\Teste
		lineageTag: 100198b9-64a3-4659-85aa-7d3e3beb8bdd

