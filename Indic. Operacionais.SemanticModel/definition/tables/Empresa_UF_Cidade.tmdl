	partition Empresa_UF_Cidade = calculated
		mode: import
		source = ```
				
				DISTINCT (
				    UNION (
				        SELECTCOLUMNS (
				            'mvp base_clientes',
				            "Empresa", 'mvp base_clientes'[empresa],
				            "UF", 'mvp base_clientes'[ajuste_uf],
				            "Cidade", 'mvp base_clientes'[ajuste_cidade]
				            
				        ),
				        SELECTCOLUMNS (
				            'mvp solicitacao_servicos',
				            "Empresa", 'mvp solicitacao_servicos'[empresa],
				            "UF", 'mvp solicitacao_servicos'[uf_ajustada],
				            "Cidade", 'mvp solicitacao_servicos'[cidade]
				        )
				    )
				)
				```

	annotation PBI_Id = 070aea595984490886e4bb96288f8467

