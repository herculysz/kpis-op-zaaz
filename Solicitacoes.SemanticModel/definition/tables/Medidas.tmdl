		formatString: 0.00
		displayFolder: Garantia\Pesos
		lineageTag: 7c7d2d8e-6f18-4d28-80be-97776f15292c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure peso_feriado =
			
			
			IF(SELECTEDVALUE(d_Calendario[feriado], FALSE()), 0.15, 0.00)
		formatString: 0.00
		displayFolder: Garantia\Pesos
		lineageTag: 62db4f28-bc3f-4d55-8ef2-64af8d78a7a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Reincidente =
			
			
			IF(
			    [Proj. Total] > 0,
			    COALESCE(
			        VAR _ChamadosBase =
			            CALCULATETABLE(
			                ADDCOLUMNS(
			                    SUMMARIZE(
			                        'mvp solicitacao_servicos',
			                        'mvp solicitacao_servicos'[protocolo],
			                        'mvp solicitacao_servicos'[id_contrato]
			                    ),
			                    "@DataFechamento", CALCULATE(MAX('mvp solicitacao_servicos'[data_fechamento])),
			                    "@DataFimGarantia", CALCULATE(MAX('mvp solicitacao_servicos'[data_termino_garantia]))
			                ),
			                'mvp solicitacao_servicos'[tipo_servico] = "GROSS - ATIV",
			                'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"},
			                USERELATIONSHIP(
			                    d_Calendario[data],
			                    'mvp solicitacao_servicos'[data_fechamento]
			                )
			            )
			        VAR _TodosChamados =
			            CALCULATETABLE(
			                ADDCOLUMNS(
			                    SUMMARIZE(
			                        'mvp solicitacao_servicos',
			                        'mvp solicitacao_servicos'[protocolo],
			                        'mvp solicitacao_servicos'[id_contrato]
			                    ),
			                    "@DataAbertura", CALCULATE(MIN('mvp solicitacao_servicos'[data_abertura]))
			                ),
			                REMOVEFILTERS(d_Calendario),
			                'mvp solicitacao_servicos'[tipo_servico] = "REPARO",
			                'mvp solicitacao_servicos'[status] IN {"ENCERRAMENTO", "FINALIZADA", "FECHAMENTO"}
			            )
			        VAR _Reincidentes =
			            FILTER(
			                _ChamadosBase,
			                VAR _ProtocoloOriginal = [protocolo]
			                VAR _ContratoOriginal = [id_contrato]
			                VAR _DataFechamentoOriginal = [@DataFechamento]
			                VAR _DataFimGarantia = [@DataFimGarantia]
			                RETURN
			                    COUNTROWS(
			                        FILTER(
			                            _TodosChamados,
			                            [id_contrato] = _ContratoOriginal
			                                && [protocolo] <> _ProtocoloOriginal
			                                && [@DataAbertura] >= _DataFechamentoOriginal
			                                && [@DataAbertura] <= _DataFimGarantia
			                        )
			                    ) > 0
			            )
			        RETURN COUNTROWS(_Reincidentes),
			        0
			    ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Garantia\Totais
		lineageTag: 5ae166c4-b1b0-4ecb-ac0c-17b05abbd624

	measure 'DU REAL' =
			
			
			VAR _DataReferencia =
			    CALCULATE(
			        MAX('mvp solicitacao_servicos'[data_fechamento]),
			        ALLSELECTED('mvp solicitacao_servicos'),
			        USERELATIONSHIP(
			            d_Calendario[data],
			            'mvp solicitacao_servicos'[data_fechamento]
			        )
			    )
			VAR _InicioMes = DATE(YEAR(_DataReferencia), MONTH(_DataReferencia), 1)
			RETURN
			    SUMX(
			        FILTER(
			            ALL(d_Calendario),
			            d_Calendario[data] >= _InicioMes
			                && d_Calendario[data] <= _DataReferencia
			        ),
			        [peso_dia_util] + [peso_sabado] + [peso_domingo] + [peso_feriado]
			    )
		formatString: 0.00
		displayFolder: Garantia\DiasUteis
		lineageTag: fe5f6298-1855-48b5-a598-351ba7dafdcb

	measure 'DU PLAN' =
			
			
			VAR _DataReferencia =
			    CALCULATE(
			        MAX('mvp solicitacao_servicos'[data_fechamento]),
			        ALLSELECTED('mvp solicitacao_servicos'),
			        USERELATIONSHIP(
			            d_Calendario[data],
			            'mvp solicitacao_servicos'[data_fechamento]
			        )
			    )
			VAR _InicioMes = DATE(YEAR(_DataReferencia), MONTH(_DataReferencia), 1)
			VAR _FimMes = EOMONTH(_DataReferencia, 0)
			RETURN
			    SUMX(
			        FILTER(
			            ALL(d_Calendario),
			            d_Calendario[data] >= _InicioMes
			                && d_Calendario[data] <= _FimMes
			        ),
			        [peso_dia_util] + [peso_sabado] + [peso_domingo] + [peso_feriado]
			    )
		formatString: 0.00
		displayFolder: Garantia\DiasUteis
		lineageTag: 9fd27f7c-1ea8-4ff9-bf64-a135cb104132

	measure 'Proj. Rein' =
			
			
			IF(
			    [Proj. Total] > 0,
			    COALESCE(
			        ROUND(
			            DIVIDE(
			                [Reincidente],
			                [DU REAL]
			            ) * [DU PLAN],
			            0
			        ),
			        0
			    ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Garantia\Totais
		lineageTag: 1fc2dd3e-0fef-4d5d-b9e7-43d4c2580a4a

	measure 'Proj. Total' =
			
			
			IF([PRODUTIVAS] = 0, BLANK(),
			    ROUND(
			        DIVIDE(
			            [PRODUTIVAS],
			            [DU REAL]
			        ) * [DU PLAN],
			        0
			    )
			)
		formatString: #,0
		displayFolder: Garantia\Totais
		lineageTag: a2156f76-e347-4c9b-9e1a-7855d6583918

	measure '{PER} Projecao_Reincidencia_meta' =
			
			
