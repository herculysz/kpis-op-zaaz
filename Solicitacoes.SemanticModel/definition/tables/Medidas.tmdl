	measure @cor_txt_eficacia_taxa =
			
			
			VAR Taxa = [{PER} eficacia_taxa]
			VAR Meta = [{PER} eficacia_meta]
			VAR RedLight = Meta - 0.05
			RETURN
			
			SWITCH(
			    TRUE(),
			    ISBLANK(Taxa), BLANK(),
			    Taxa < 0, BLANK(),
			    Taxa < RedLight, "#7F0000",
			    Taxa < Meta, "#856c16",
			    "#1b6242"
			)
		displayFolder: GrossAtivacao\cores
		lineageTag: ff551008-3dbc-4db5-9e5d-bdd9b1863d59

