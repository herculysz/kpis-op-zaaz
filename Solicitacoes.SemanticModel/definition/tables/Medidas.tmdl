table Medidas
	lineageTag: 4b362e9d-aa35-4bdf-9a66-4a20a11fc8eb

	measure Backlog =
			
			CALCULATE(
			      [Qtd Solicitacoes]
			    , ISBLANK('mvp solicitacao_servicos'[data_fechamento])
			)
		formatString: 0
		displayFolder: Backlog
		lineageTag: 52bc39de-efa2-4e7b-b085-c6174d93f30f

	measure 'Qtd Solicitacoes' = COUNTROWS('mvp solicitacao_servicos')
		formatString: #,0
		displayFolder: Backlog\Gerais
		lineageTag: 8cd5392e-29b7-49b0-bbbb-49c058ed6acf

	measure 'Backlog Reparos' =
			
			CALCULATE(
			      [Backlog]
			    , 'mvp solicitacao_servicos'[tipo_servico] = "Reparo"
			)
		formatString: 0
		displayFolder: Backlog
		lineageTag: 2174f6db-40cd-4e16-8394-ec13cd8f6e81

	measure 'Backlog Total' =
			
			-- Dados validados por Oliveira
			var vTipo = SELECTEDVALUE('mvp solicitacao_servicos'[tipo_servico])
			return
			CALCULATE(
			      [Qtd Solicitacoes]
			    , 'mvp solicitacao_servicos'[tipo_servico] = vTipo
			    , 'mvp solicitacao_servicos'[status] IN {"ABERTA","AGENDADA","ANDAMENTO","ENCAMINHADA","ABERTURA"}
			    , USERELATIONSHIP( 'mvp solicitacao_servicos'[data_abertura], d_Calendario[data] )
			)
		formatString: 0
		displayFolder: Backlog
		lineageTag: 9d5e8cc1-8872-4ccb-bcdc-922bd6233a52

	measure Fila =
			
			DIVIDE(
			    [Backlog Total],
			    [Media Solicitacoes Encerradas 7d]
			)
		displayFolder: Backlog\Gerais
		lineageTag: f350e557-8993-42c0-ad0a-a8dd8eaab978

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qtd Solicitacoes Encerradas 7d' =
			
			VAR vDt_Contexto = IF( MAX(d_Calendario[data]) > TODAY(), TODAY(), MAX(d_Calendario[data]) )
			VAR vDt_Ult_7d = vDt_Contexto-7
			VAR vPeriodo =
			    DATESBETWEEN(
			        d_Calendario[data],
			        vDt_Ult_7d,
			        vDt_Contexto -1 //Para considerar apenas os 7 dias anteriores à data do contexto, pois DATESBETWEEN é inclusiva
			    )
			VAR vSolicitacoesEncerradas =
			    CALCULATE(
			        [Qtd Solicitacoes],
			        vPeriodo,
			        USERELATIONSHIP(
			            'mvp solicitacao_servicos'[data_fechamento],
			            d_Calendario[data]
			        )
			    )
			RETURN
			vSolicitacoesEncerradas
		formatString: #,0
		displayFolder: Backlog\Gerais
		lineageTag: 27d58745-87c1-457e-8481-7a0256f844a7

	measure 'Media Solicitacoes Encerradas 7d' =
			
			VAR vSolicitacoesEncerradas = [Qtd Solicitacoes Encerradas 7d]
			VAR vMedia = DIVIDE( vSolicitacoesEncerradas, 6 )
			RETURN
			vMedia
		formatString: 0
		displayFolder: Backlog\Gerais
		lineageTag: cf111fc6-fb18-452a-820c-9c93d11791cd

